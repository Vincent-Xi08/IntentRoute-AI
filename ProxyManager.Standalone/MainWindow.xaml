<Window x:Class="ProxyManager.Standalone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxyManager.Standalone.Localization"
        Title="{x:Static loc:Strings.WindowTitle}" Height="720" Width="1040"
        MinHeight="500" MinWidth="750"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True">

    <!--
      v0.16 起设计系统统一在 App.xaml：色彩、按钮、输入框、下拉框、导航等
      全部由应用级资源提供（含 PrimaryBtn/SecondaryBtn/BgBrush 等历史别名）。
      窗口本地仅保留本窗口特有的转换器与规则右键菜单。
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 右键菜单 -->
        <ContextMenu x:Key="RuleMenu" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
            <MenuItem Header="{x:Static loc:Strings.MenuEditConstraints}" Click="EditRuleConstraints_Click" Foreground="{StaticResource TextBrush}"/>
            <MenuItem Header="{x:Static loc:Strings.MenuToggleEnabled}" Click="ToggleRule_Click" Foreground="{StaticResource TextBrush}"/>
            <Separator Background="{StaticResource BorderBrush}"/>
            <MenuItem Header="{x:Static loc:Strings.MenuForceProxy}" Click="SetProxy_Click" Foreground="{StaticResource TextBrush}"/>
            <MenuItem Header="{x:Static loc:Strings.MenuForceDirect}" Click="SetDirect_Click" Foreground="{StaticResource TextBrush}"/>
            <MenuItem Header="{x:Static loc:Strings.MenuForceBlock}" Click="SetBlock_Click" Foreground="{StaticResource TextBrush}"/>
            <Separator Background="{StaticResource BorderBrush}"/>
            <MenuItem Header="{x:Static loc:Strings.MenuMoveUp}" Click="MoveUp_Click" Foreground="{StaticResource TextBrush}"/>
            <MenuItem Header="{x:Static loc:Strings.MenuMoveDown}" Click="MoveDown_Click" Foreground="{StaticResource TextBrush}"/>
            <Separator Background="{StaticResource BorderBrush}"/>
            <MenuItem Header="{x:Static loc:Strings.MenuDelete}" Click="DeleteRule_Click" Foreground="{StaticResource ErrorBrush}"/>
        </ContextMenu>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ 左侧导航栏 ═══ -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 品牌区 -->
                    <Border Grid.Row="0" Padding="16,18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="7"
                                    Background="{StaticResource AccentDimBrush}" VerticalAlignment="Center">
                                <TextBlock Text="✦" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="IntentRoute AI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SidebarVersion}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 导航菜单：分组标签 + 保持既有顺序（冒烟门禁依赖 NavRules→下方向键→NavPolicy 的相邻关系） -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,12,10,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.NavSectionWorkspace}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="12,2,0,6"/>
                            <RadioButton x:Name="NavRules" Content="{x:Static loc:Strings.NavItemRules}" GroupName="Nav" IsChecked="True"
                                         Style="{StaticResource NavButton}" Click="Nav_Click"
                                         AutomationProperties.AutomationId="NavRules" AutomationProperties.Name="{x:Static loc:Strings.NavItemRules}"/>
                            <RadioButton x:Name="NavPolicy" Content="{x:Static loc:Strings.NavItemPolicy}" GroupName="Nav"
                                         Style="{StaticResource NavButton}" Click="Nav_Click"
                                         AutomationProperties.AutomationId="NavPolicy" AutomationProperties.Name="{x:Static loc:Strings.NavItemPolicy}"/>
                            <RadioButton x:Name="NavRouteSimulator" Content="{x:Static loc:Strings.NavItemRouteSimulator}" GroupName="Nav"
                                         Style="{StaticResource NavButton}" Click="Nav_Click"
                                         AutomationProperties.AutomationId="NavRouteSimulator" AutomationProperties.Name="{x:Static loc:Strings.NavItemRouteSimulator}"/>
                            <RadioButton x:Name="NavAi" Content="{x:Static loc:Strings.NavItemAi}" GroupName="Nav"
                                         Style="{StaticResource NavButton}" Click="Nav_Click"
                                         AutomationProperties.AutomationId="NavAi" AutomationProperties.Name="{x:Static loc:Strings.NavItemAi}"/>

                            <TextBlock Text="{x:Static loc:Strings.NavSectionRuntime}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="12,14,0,6"/>
                            <RadioButton x:Name="NavMonitor" Content="{x:Static loc:Strings.NavItemMonitor}" GroupName="Nav"
                                         Style="{StaticResource NavButton}" Click="Nav_Click"
                                         AutomationProperties.AutomationId="NavMonitor" AutomationProperties.Name="{x:Static loc:Strings.NavItemMonitor}"/>
                            <RadioButton x:Name="NavProcess" Content="{x:Static loc:Strings.NavItemProcess}" GroupName="Nav"
                                         Style="{StaticResource NavButton}" Click="Nav_Click"
                                         AutomationProperties.AutomationId="NavProcess" AutomationProperties.Name="{x:Static loc:Strings.NavItemProcess}"/>

                            <TextBlock Text="{x:Static loc:Strings.NavSectionApp}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="12,14,0,6"/>
                            <RadioButton x:Name="NavSettings" Content="{x:Static loc:Strings.NavItemSettings}" GroupName="Nav"
                                         Style="{StaticResource NavButton}" Click="Nav_Click"
                                         AutomationProperties.AutomationId="NavSettings" AutomationProperties.Name="{x:Static loc:Strings.NavItemSettings}"/>
                            <RadioButton x:Name="NavAbout" Content="{x:Static loc:Strings.NavItemAbout}" GroupName="Nav"
                                         Style="{StaticResource NavButton}" Click="Nav_Click"
                                         AutomationProperties.AutomationId="NavAbout" AutomationProperties.Name="{x:Static loc:Strings.NavItemAbout}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部状态 -->
                    <Border Grid.Row="2" Padding="14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedTextBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusLabel" Text="{x:Static loc:Strings.StatusFooterLabel}" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusDetail" Text="{x:Static loc:Strings.StatusFooterInitial}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                       MaxHeight="52" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 右侧内容区 ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部标题栏 -->
                <Border Grid.Row="0" Background="{StaticResource BgBrush}" Padding="20,12,8,10"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 标题：主副两行，基线对齐 -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="{x:Static loc:Strings.PageTitleRules}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="PageSubtitle" Text="{x:Static loc:Strings.PageSubtitleRules}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- 全局模式切换（分段控件） -->
                        <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="7" Padding="3"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeDirect" Content="{x:Static loc:Strings.ModeDirectLabel}" GroupName="Mode" IsChecked="True"
                                             Style="{StaticResource SegmentItem}" Click="Mode_Changed"
                                             AutomationProperties.Name="{x:Static loc:Strings.ModeDirectLabel}"/>
                                <RadioButton x:Name="ModeProxy" Content="{x:Static loc:Strings.ModeProxyLabel}" GroupName="Mode"
                                             Style="{StaticResource SegmentItem}" Click="Mode_Changed"
                                             AutomationProperties.Name="{x:Static loc:Strings.ModeProxyLabel}"/>
                            </StackPanel>
                        </Border>

                        <!-- 窗口控制 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="—" Style="{StaticResource WindowButton}"
                                    AutomationProperties.AutomationId="WindowMinimize" AutomationProperties.Name="{x:Static loc:Strings.WindowMinimizeName}"
                                    Click="Minimize_Click"/>
                            <Button Content="□" Style="{StaticResource WindowButton}"
                                    AutomationProperties.AutomationId="WindowMaximize" AutomationProperties.Name="{x:Static loc:Strings.WindowMaximizeName}"
                                    Click="Maximize_Click"/>
                            <Button Content="✕" Style="{StaticResource WindowCloseButton}"
                                    AutomationProperties.AutomationId="WindowClose" AutomationProperties.Name="{x:Static loc:Strings.WindowCloseName}"
                                    Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 配置恢复阻断提示 -->
                <Border x:Name="ConfigRecoveryBanner" Grid.Row="1" Visibility="Collapsed"
                        Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="16,8,16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{x:Static loc:Strings.RecoveryBannerTitle}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock x:Name="ConfigRecoveryText" Margin="0,4,0,0" TextWrapping="Wrap"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{x:Static loc:Strings.RecoveryOpenFolder}" Style="{StaticResource SecondaryBtn}" Padding="10,5"
                                    Margin="0,0,6,0" Click="OpenConfigFolder_Click"/>
                            <Button x:Name="RecoverConfigButton" Content="{x:Static loc:Strings.RecoveryImport}" Style="{StaticResource SecondaryBtn}" Padding="10,5"
                                    Margin="0,0,6,0" Click="RecoverConfig_Click"/>
                            <Button x:Name="ResetConfigButton" Content="{x:Static loc:Strings.RecoveryReset}" Style="{StaticResource PrimaryBtn}" Padding="10,5"
                                    Click="ResetConfig_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 主内容区 -->
                <Grid Grid.Row="2" Margin="16,8,16,16">
                    <!-- 页面: 规则管理 -->
                    <Grid x:Name="PageRules" Visibility="Visible" AllowDrop="True"
                          Drop="Window_Drop" DragOver="Window_DragOver" DragLeave="Window_DragLeave">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 顶部主题色区域 -->
                        <Border Grid.Row="0" Style="{StaticResource AccentHeaderCard}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="6"
                                        Background="{StaticResource AccentDimBrush}" VerticalAlignment="Center">
                                    <Path Data="M12,2 L12,12 M7,7 L12,2 L17,7" Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stretch="Uniform" Margin="8"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.PageTitleRules}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{x:Static loc:Strings.PageSubtitleRules}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 工具栏：第一行搜索/统计/主操作，第二行批量与危险操作 -->
                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8"
                                Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 搜索框 -->
                                    <Grid Grid.Column="0" Margin="0,0,12,0">
                                        <TextBox x:Name="SearchBox" Width="240"
                                                 Style="{StaticResource InputBox}" FontSize="12"
                                                 TextChanged="Search_Changed"/>
                                        <TextBlock x:Name="SearchPlaceholder" Text="{x:Static loc:Strings.RulesSearchPlaceholder}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12" Margin="11,0,0,0"
                                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                                   Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>

                                    <!-- 统计徽标 -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="9,3" Margin="0,0,6,0">
                                            <TextBlock x:Name="ProxyCount" Text="代理: 0" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="10" Padding="9,3" Margin="0,0,6,0">
                                            <TextBlock x:Name="DirectCount" Text="直连: 0" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                                        </Border>
                                        <Border Background="{StaticResource ErrorSoftBrush}" CornerRadius="10" Padding="9,3">
                                            <TextBlock x:Name="BlockCount" Text="阻止: 0" FontSize="11" Foreground="{StaticResource ErrorBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 主操作 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="{x:Static loc:Strings.RulesAdd}" Style="{StaticResource PrimaryBtn}"
                                                Click="AddRule_Click" Margin="0,0,8,0"/>
                                        <Button Content="{x:Static loc:Strings.RulesImport}" Style="{StaticResource SecondaryBtn}"
                                                Click="Import_Click" Margin="0,0,8,0"/>
                                        <Button Content="{x:Static loc:Strings.RulesExport}" Style="{StaticResource SecondaryBtn}"
                                                Click="Export_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 批量/危险操作行 -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BatchEnableButton" Content="{x:Static loc:Strings.RulesBatchEnable}" Style="{StaticResource SecondaryBtn}"
                                            FontSize="11" Padding="12,5"
                                            Margin="0,0,6,0" IsEnabled="False"
                                            AutomationProperties.Name="{x:Static loc:Strings.RulesBatchEnableAutomation}" Click="BatchEnable_Click"/>
                                    <Button x:Name="BatchDisableButton" Content="{x:Static loc:Strings.RulesBatchDisable}" Style="{StaticResource SecondaryBtn}"
                                            FontSize="11" Padding="12,5"
                                            Margin="0,0,6,0" IsEnabled="False"
                                            AutomationProperties.Name="{x:Static loc:Strings.RulesBatchDisableAutomation}" Click="BatchDisable_Click"/>
                                    <Button x:Name="BatchDeleteButton" Content="{x:Static loc:Strings.RulesBatchDelete}" Style="{StaticResource SecondaryBtn}"
                                            FontSize="11" Padding="12,5"
                                            Margin="0,0,6,0" IsEnabled="False" Foreground="{StaticResource ErrorBrush}"
                                            AutomationProperties.Name="{x:Static loc:Strings.RulesBatchDeleteAutomation}" Click="BatchDelete_Click"/>
                                    <Button x:Name="BatchProxyButton" Content="{x:Static loc:Strings.RulesBatchProxy}" Style="{StaticResource SecondaryBtn}"
                                            FontSize="11" Padding="12,5"
                                            Margin="0,0,6,0" IsEnabled="False" Tag="Proxy"
                                            AutomationProperties.Name="{x:Static loc:Strings.RulesBatchProxyAutomation}" Click="BatchMode_Click"/>
                                    <Button x:Name="BatchDirectButton" Content="{x:Static loc:Strings.RulesBatchDirect}" Style="{StaticResource SecondaryBtn}"
                                            FontSize="11" Padding="12,5"
                                            Margin="0,0,6,0" IsEnabled="False" Tag="Direct"
                                            AutomationProperties.Name="{x:Static loc:Strings.RulesBatchDirectAutomation}" Click="BatchMode_Click"/>
                                    <Button x:Name="BatchBlockButton" Content="{x:Static loc:Strings.RulesBatchBlock}" Style="{StaticResource SecondaryBtn}"
                                            FontSize="11" Padding="12,5"
                                            Margin="0,0,6,0" IsEnabled="False" Tag="Block"
                                            AutomationProperties.Name="{x:Static loc:Strings.RulesBatchBlockAutomation}" Click="BatchMode_Click"/>
                                    <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                                    <Button Content="{x:Static loc:Strings.RulesClear}" Style="{StaticResource SecondaryBtn}"
                                            FontSize="11" Padding="12,5" Foreground="{StaticResource ErrorBrush}"
                                            Click="Clear_Click"/>
                                    <TextBlock Text="{x:Static loc:Strings.RulesBatchHint}" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="12,0,0,0"/>
                                    <TextBlock x:Name="BatchResultText" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{StaticResource SuccessBrush}" Margin="12,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 规则列表 -->
                        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="8">
                            <Grid>
                                <!-- 表头 -->
                                <Border VerticalAlignment="Top" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="#" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.RulesHeaderApp}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{x:Static loc:Strings.RulesHeaderMode}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{x:Static loc:Strings.RulesHeaderStatus}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{x:Static loc:Strings.RulesHeaderTime}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="" FontSize="11"/>
                                    </Grid>
                                </Border>

                                <!-- 列表内容 -->
                                <ListBox x:Name="RulesList" Margin="0,38,0,0" Background="Transparent"
                                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionMode="Extended" SelectionChanged="RulesList_SelectionChanged"
                                         ContextMenu="{StaticResource RuleMenu}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SelectionSoftBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="50" Margin="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,7">
                                                    <TextBlock Text="{Binding ExeName}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ExePath}"/>
                                                    <TextBlock Text="{Binding ConditionSummary}" FontSize="10.5"
                                                               Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding ModeColor}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ModeText}" FontSize="11" Margin="6,0,0,0"
                                                               Foreground="{Binding ModeColor}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding CreatedAt}" FontSize="10.5"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="⋮" FontSize="16"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           ToolTip="{x:Static loc:Strings.RulesRowMenuHint}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 空状态：图标 → 标题 → 描述 → 双操作 -->
                                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="14"
                                            Background="{StaticResource SurfaceBrush}" HorizontalAlignment="Center">
                                        <Path Data="M3,6 C3,4.9 3.9,4 5,4 L10,4 L12,6.5 L21,6.5 C22.1,6.5 23,7.4 23,8.5 L23,18 C23,19.1 22.1,20 21,20 L5,20 C3.9,20 3,19.1 3,18 Z"
                                              Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.6" Fill="Transparent"
                                              Stretch="Uniform" Margin="12"/>
                                    </Border>
                                    <TextBlock Text="{x:Static loc:Strings.RulesEmptyPrimary}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                    <TextBlock Text="{x:Static loc:Strings.RulesEmptySecondary}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                        <Button Content="{x:Static loc:Strings.RulesAdd}" Style="{StaticResource PrimaryBtn}"
                                                Click="AddRule_Click" Margin="0,0,8,0"/>
                                        <Button Content="{x:Static loc:Strings.RulesImport}" Style="{StaticResource SecondaryBtn}"
                                                Click="Import_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 拖拽覆盖层 -->
                                <Border x:Name="DropOverlay" Background="{StaticResource OverlayBrush}" Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Width="72" Height="72" CornerRadius="16"
                                                Background="{StaticResource AccentSoftBrush}"
                                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                                HorizontalAlignment="Center">
                                            <Path Data="M12,3 L12,14 M12,3 L7,8 M12,3 L17,8 M4,15 L4,19 C4,20.1 4.9,21 6,21 L18,21 C19.1,21 20,20.1 20,19 L20,15"
                                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Stretch="Uniform" Margin="14"/>
