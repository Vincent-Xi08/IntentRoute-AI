//! Persisted rule model, JSON-compatible with the C# `AppConfigStore` format.
//!
//! Newtonsoft on the C# side serializes enums as numbers, so `ProxyMode` uses a
//! numeric representation (`0` = Proxy, `1` = Direct, `2` = Block) with
//! unknown values rejected — matching the C# `Enum.IsDefined` commit guard.
//! `Id` is required at the JSON boundary exactly like the C# model
//! (`[JsonProperty(Required = Required.Always)]`); unknown members are
//! tolerated for forward compatibility.

use serde::{Deserialize, Serialize};

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub enum ProxyMode {
    Proxy,
    Direct,
    Block,
}

impl ProxyMode {
    pub fn as_u8(self) -> u8 {
        match self {
            ProxyMode::Proxy => 0,
            ProxyMode::Direct => 1,
            ProxyMode::Block => 2,
        }
    }

    pub fn name(self) -> &'static str {
        match self {
            ProxyMode::Proxy => "Proxy",
            ProxyMode::Direct => "Direct",
            ProxyMode::Block => "Block",
        }
    }
}

impl TryFrom<u8> for ProxyMode {
    type Error = ();

    fn try_from(value: u8) -> Result<Self, Self::Error> {
        match value {
            0 => Ok(ProxyMode::Proxy),
            1 => Ok(ProxyMode::Direct),
            2 => Ok(ProxyMode::Block),
            _ => Err(()),
        }
    }
}

impl Serialize for ProxyMode {
    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
        serializer.serialize_u8(self.as_u8())
    }
}

impl<'de> Deserialize<'de> for ProxyMode {
    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
        let value = u8::deserialize(deserializer)?;
        ProxyMode::try_from(value)
            .map_err(|_| serde::de::Error::custom("unsupported ProxyMode value (expected 0-2)"))
    }
}

fn default_mode() -> ProxyMode {
    ProxyMode::Proxy
}

fn default_string() -> String {
    String::new()
}

fn default_true() -> bool {
    true
}

#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
pub struct ProxyRule {
    #[serde(rename = "Id")]
    pub id: String,
    #[serde(rename = "ExeName", default = "default_string")]
    pub exe_name: String,
    #[serde(rename = "ExePath", default = "default_string")]
    pub exe_path: String,
    #[serde(rename = "Mode", default = "default_mode")]
    pub mode: ProxyMode,
    #[serde(rename = "CreatedAt", default = "default_string")]
    pub created_at: String,
    #[serde(rename = "Note", default = "default_string")]
    pub note: String,
    #[serde(rename = "TargetHosts", default = "default_string")]
    pub target_hosts: String,
    #[serde(rename = "TargetIPs", default = "default_string")]
    pub target_ips: String,
    #[serde(rename = "TargetPorts", default = "default_string")]
    pub target_ports: String,
    #[serde(rename = "Protocol", default = "default_string")]
    pub protocol: String,
    #[serde(rename = "ProxyId", default = "default_string")]
    pub proxy_id: String,
    #[serde(rename = "ProxyChainId", default = "default_string")]
    pub proxy_chain_id: String,
    #[serde(rename = "Priority", default)]
    pub priority: i32,
    #[serde(rename = "IsEnabled", default = "default_true")]
    pub is_enabled: bool,
}

impl ProxyRule {
    pub fn new(id: impl Into<String>, exe_name: impl Into<String>) -> Self {
        Self {
            id: id.into(),
            exe_name: exe_name.into(),
            exe_path: String::new(),
            mode: ProxyMode::Proxy,
            created_at: String::new(),
            note: String::new(),
            target_hosts: String::new(),
            target_ips: String::new(),
            target_ports: String::new(),
            protocol: String::new(),
            proxy_id: String::new(),
            proxy_chain_id: String::new(),
            priority: 0,
            is_enabled: true,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn parses_export_json_with_numeric_mode_and_required_id() {
        let json = r#"{
            "Id": "r1", "ExeName": "a.exe", "Mode": 1, "IsEnabled": false,
            "Priority": 40, "TargetHosts": "github.com", "Protocol": "TCP"
        }"#;
        let rule: ProxyRule = serde_json::from_str(json).unwrap();
        assert_eq!(rule.mode, ProxyMode::Direct);
        assert!(!rule.is_enabled);
        assert_eq!(rule.priority, 40);
        assert_eq!(rule.target_hosts, "github.com");
        assert_eq!(rule.protocol, "TCP");
    }

    #[test]
    fn missing_id_is_rejected() {
        let json = r#{"ExeName": "a.exe"}"#;
        assert!(serde_json::from_str::<ProxyRule>(json).is_err());
    }

    #[test]
    fn unknown_mode_is_rejected() {
        let json = r#"{"Id": "r1", "Mode": 9}"#;
        assert!(serde_json::from_str::<ProxyRule>(json).is_err());
    }

    #[test]
    fn unknown_members_are_tolerated() {
        let json = r#"{"Id": "r1", "ExeName": "a.exe", "FutureField": true}"#;
        let rule: ProxyRule = serde_json::from_str(json).unwrap();
        assert_eq!(rule.exe_name, "a.exe");
    }

    #[test]
    fn serializes_back_with_csharp_shape() {
        let rule = ProxyRule::new("r1", "a.exe");
        let json = serde_json::to_string(&rule).unwrap();
        assert!(json.contains(r#""Mode":0"#), "numeric enum parity: {json}");
        assert!(json.contains(r#""ExeName":"a.exe""#));
    }
}
